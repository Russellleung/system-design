# Default provider. Change to openai to use the retained fallback adapter.
VISION_PROVIDER=gemini

# Server-only secret. Configure this in Render, never in NEXT_PUBLIC_*.
GEMINI_API_KEY=

# Optional. Defaults to the free-tier-compatible vision model below.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Optional paid image-editing model. Leave unset to prevent image-generation spend.
# Current recommended value: gemini-3.1-flash-lite-image
GEMINI_IMAGE_MODEL=

# Optional OpenAI fallback. Leave the provider set to gemini unless switching.
OPENAI_API_KEY=

# Optional. Defaults to the current vision-capable mini model.
OPENAI_VISION_MODEL=gpt-5.4-mini

# Optional until saved analyses/authentication are enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only migration/admin jobs may use this. Never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
